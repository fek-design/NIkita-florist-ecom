# Copy to .env.local for development. Never commit real values.

# PostgreSQL connection string. This default is the local database from
# `docker compose up -d`; hosted environments set their own in Vercel.
DATABASE_URL=postgres://florist:florist@localhost:5432/florist

# Port for the local server (Vercel ignores it).
PORT=4000

# Shared secret for POST /jobs/<name>, sent by the GitHub Actions schedule
# as "Authorization: Bearer <secret>". Generate with: openssl rand -hex 32
JOB_SECRET=

# Stripe (payment). Test-mode keys during the project; the owner's live keys
# at hand-over. Secret key from the Stripe dashboard > Developers > API keys
# (starts with sk_test_). Webhook signing secret from the webhook endpoint,
# or from `stripe listen` locally (starts with whsec_).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Second layer on the Stripe webhook: is the caller one of Stripe's published
# addresses? report (default): log unknown callers, let them through;
# enforce: refuse them (planned for the hardening week); off: no check.
STRIPE_WEBHOOK_IP_CHECK=report
