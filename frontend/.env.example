# Copy to .env.local for development. Never commit real values.
# The frontend holds no database credentials: all data goes through the backend.

# Address of the backend API. Local: npm run dev -w backend
BACKEND_URL=http://localhost:4000

# The shop's public address (sitemap, robots.txt, product data). Optional:
# without it Vercel's production address is used, locally localhost:3000.
SITE_URL=http://localhost:3000
